# ============================================================
# Incident Management Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# -----------------------------------------------------------
# Google Cloud
# -----------------------------------------------------------
# Your GCP project ID (required for Firestore)
PROJECT_ID=devops-lab-498208

# Firestore collection name (default: incidents)
FIRESTORE_COLLECTION=incidents

# -----------------------------------------------------------
# Application
# -----------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# -----------------------------------------------------------
# Local development — Firestore emulator
# -----------------------------------------------------------
# Uncomment to use the local Firestore emulator instead of GCP
# FIRESTORE_EMULATOR_HOST=localhost:8085
